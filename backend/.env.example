# Copy to backend/.env and fill in your values.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

DATABASE_URL=sqlite:///./app.db
SYNTAX_TIMEOUT_SECONDS=5
RUNNER_TEST_TIMEOUT_SECONDS=10
RUNNER_SUBMIT_TIMEOUT_SECONDS=30
FRONTEND_ORIGIN=http://localhost:5173

# Required for project analysis, problem generation, hints, LLM grading, and paper mode.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: where GitHub repos are cloned (default: ~/.codepractice/repos)
# GITHUB_CLONE_BASE_PATH=~/.codepractice/repos
